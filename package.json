{
  "name": "odubo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --no-lint",
    "build:deploy": "npx --yes @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "next lint",
    "test:performance": "node scripts/test-performance.js",
    "lighthouse": "lhci autorun",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "pages:build": "next-on-pages build",
    "migrate:r2-to-stream": "tsx scripts/migrate_r2_to_stream.ts",
    "migrate:videos": "tsx --env-file=.env.local scripts/migrate_video_files_to_organized_structure.ts",
    "preview:migration": "tsx --env-file=.env.local scripts/preview_video_migration.ts",
    "organize:videos": "tsx --env-file=.env.local scripts/organize_video_metadata.ts",
    "fix:albums": "tsx --env-file=.env.local scripts/fix_album_issues.ts",
    "deploy:prod": "./scripts/deploy_production.sh",
    "deploy:prod:organize": "./scripts/deploy_production.sh --organize-media",
    "deploy:cf": "./scripts/deploy_cloudflare_pages.sh",
    "deploy:cf:secrets": "./scripts/deploy_cloudflare_pages.sh --skip-migrations --set-secrets",
    "deploy:cf:full": "./scripts/deploy_cloudflare_pages.sh --organize-media --set-secrets",
    "audio:transcode:track": "tsx --env-file=.env.local scripts/transcode_audio_to_web.ts --track",
    "audio:transcode:album": "tsx --env-file=.env.local scripts/transcode_audio_to_web.ts --album",
    "audio:transcode:all": "tsx --env-file=.env.local scripts/transcode_audio_to_web.ts --all",
    "audio:cleanup": "tsx --env-file=.env.local scripts/cleanup_unused_audio_files.ts",
    "audio:hls:track": "tsx --env-file=.env.local scripts/transcode_audio_to_hls.ts --track",
    "audio:hls:album": "tsx --env-file=.env.local scripts/transcode_audio_to_hls.ts --album",
    "audio:hls:all": "tsx --env-file=.env.local scripts/transcode_audio_to_hls.ts --all",
    "generate-icons": "node ./scripts/generate-icons.js",
    "db:apply:featured": "tsx --env-file=.env scripts/apply_featured_singleton.ts || tsx --env-file=.env.local scripts/apply_featured_singleton.ts",
    "moments:test": "node scripts/test_moments_connectivity.mjs",
    "moments:create-gallery": "node scripts/create_gallery.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.858.0",
    "@aws-sdk/s3-request-presigner": "^3.910.0",
    "@cloudflare/kv-asset-handler": "^0.4.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/postcss": "^4.1.11",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "dotenv": "^17.2.1",
    "formdata-node": "^6.0.3",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.12",
  "gsap": "^3.12.5",
    "hls.js": "^1.5.15",
    "jose": "^5.2.0",
    "jwt-decode": "^4.0.0",
    "next": "15.4.5",
    "node-fetch": "^2.7.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.7.0",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.11",
    "uuid": "^11.1.0",
    "wrangler": "^4.27.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.14",
    "@cloudflare/workers-types": "^4.20250801.0",
    "@eslint/eslintrc": "^3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/busboy": "^1.5.4",
    "@types/formidable": "^3.4.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "esbuild": "^0.14.47",
    "eslint": "^9",
    "eslint-config-next": "15.4.5",
    "ffmpeg-static": "^5.2.0",
    "tsx": "^4.20.4",
    "typescript": "^5"
  }
}
