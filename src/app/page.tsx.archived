'use client';

import { useMusicPlayer } from '@/contexts/MusicPlayerContext';
import { useRouter } from 'next/navigation';
import { useState, useEffect } from 'react';
import Image from 'next/image';

export default function Home() {
  const { 
    state, 
    togglePlayPause, 
    nextTrack, 
    previousTrack, 
    loadLibraryTracks, 
    enterLibraryShuffleMode,
    playAlbum
  } = useMusicPlayer();
  const router = useRouter();

  // State for albums
  const [albums, setAlbums] = useState<any[]>([]);
  const [loadingAlbums, setLoadingAlbums] = useState(false);
  const [albumError, setAlbumError] = useState<string | null>(null);

  // Bible widget state with Gemini integration
  const [verseOfTheDay, setVerseOfTheDay] = useState({
    text: "",
    reference: "",
    loading: true,
    error: null as string | null
  });

  // Dev logging removed for performance

  // Fetch verse from Gemini with small retry to ensure a fresh verse on load
  const fetchVerse = async (attempt: number = 1, lastRef?: string) => {
    try {
      setVerseOfTheDay(prev => ({ ...prev, loading: true, error: null }));
      
      const timestamp = Date.now().toString();
      const requestId = Math.random().toString(36).substring(7);

      const response = await fetch('/api/gemini', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          action: 'getVerse',
          timestamp,
          requestId,
          excludeRefs: [
            ...(verseOfTheDay.reference ? [verseOfTheDay.reference] : []),
            ...(lastRef ? [lastRef] : [])
          ]
        }),
        cache: 'no-store'
      });

      //

      if (!response.ok) {
        const errorText = await response.text();
        throw new Error(`Failed to fetch verse. Status: ${response.status}`);
      }

      const data = await response.json() as {
        text?: string;
        reference?: string;
        note?: string;
      };
      
      //

      // Explicitly check for the required data before setting the state
      if (data.text && data.reference) {
        setVerseOfTheDay({
          text: data.text,
          reference: data.reference,
          loading: false,
          error: data.note || null
        });
        //
      } else {
        // If data is incomplete, throw an error to be caught by the catch block
        //
        throw new Error('Incomplete verse data received from API.');
      }

    } catch (error) {
      // Auto-retry up to 2 more times with the last seen reference excluded
      if (attempt < 3) {
        await fetchVerse(attempt + 1, verseOfTheDay.reference || undefined);
        return;
      }
      // Fallback to a default verse after retries
      setVerseOfTheDay(prev => ({
        text: "Trust in the Lord with all your heart and lean not on your own understanding.",
        reference: "Proverbs 3:5",
        loading: false,
        error: prev.error || "Unable to fetch today's verse. Showing a timeless favorite."
      }));
    }
  };

  useEffect(() => {
    // Defer the first verse fetch to next tick to avoid any hydration timing issues
    const t = setTimeout(() => {
      fetchVerse();
    }, 0);
    loadAvailableAlbums();
    return () => clearTimeout(t);
  }, []);

  // Fetch available albums
  const loadAvailableAlbums = async () => {
    try {
      setLoadingAlbums(true);
      setAlbumError(null);
      
      const response = await fetch('/api/albums');
      //
      
      if (response.ok) {
        const data = await response.json() as { success: boolean; albums: any[] };
        
        if (data.success && Array.isArray(data.albums)) {
          //
          
          // Include ALL albums for now, not just published ones
          const availableAlbums = data.albums; // Remove the filter to see all albums
          
          setAlbums(availableAlbums);
          
          if (availableAlbums.length === 0) {
            setAlbumError('No albums found in database');
          }
        } else {
          setAlbumError('Invalid response format from albums API');
        }
      } else {
        const errorText = await response.text();
        console.error('Albums API error:', response.status, errorText);
        setAlbumError(`Failed to fetch albums: ${response.status}`);
      }
    } catch (error) {
      console.error('Failed to load albums:', error);
      setAlbumError(`Network error: ${error instanceof Error ? error.message : 'Unknown error'}`);
    } finally {
      setLoadingAlbums(false);
    }
  };

  // Play a random album
  const handlePlayRandomAlbum = async () => {
    //
    
    if (albums.length === 0) {
      //
      await loadAvailableAlbums();
      return;
    }

    // Pick a random album
    const randomAlbum = albums[Math.floor(Math.random() * albums.length)];
    //
    
    try {
      // Fetch the album details with tracks
      //
      const response = await fetch(`/api/albums/${randomAlbum.id}`);
      
      if (response.ok) {
        const data = await response.json() as { success: boolean; album: any };
          //
        
        if (data.success && data.album && Array.isArray(data.album.tracks)) {
          const album = data.album;
          const tracksWithAudio = album.tracks.filter((track: any) => track.audio_url);
           //
          
          if (tracksWithAudio.length > 0) {
            // Start with a random track
            const randomStartIndex = Math.floor(Math.random() * tracksWithAudio.length);
            playAlbum(album, tracksWithAudio, randomStartIndex);
          } else {
            console.warn('No tracks with audio_url found');
            setAlbumError('Selected album has no playable tracks');
          }
        } else {
          console.error('Invalid album details response');
          setAlbumError('Failed to load album tracks');
        }
      } else {
        console.error('Failed to fetch album details:', response.status);
        setAlbumError(`Failed to load album: ${response.status}`);
      }
    } catch (error) {
      console.error('Failed to load album tracks:', error);
      setAlbumError(`Error loading album: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  };

  const handleShufflePlay = async () => {
    if (albums.length > 0) {
      // Play a random album if we have albums loaded
      await handlePlayRandomAlbum();
    } else {
      // Fallback to library tracks
      if (state.libraryTracks.length === 0) {
        await loadLibraryTracks();
      }
      enterLibraryShuffleMode();
    }
  };

  const handleBrowseMusic = () => {
    router.push('/music');
  };

  const formatTime = (seconds: number): string => {
    if (!seconds || isNaN(seconds)) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  };

  return (
    <div className="flex flex-col h-full min-h-0 relative">
      {/* Simplified Background */}
      <div className="fixed inset-0 -z-10 bg-gradient-to-br from-stone-950 via-stone-900 to-red-950" />

      {/* Content area with dynamic layout (scrollable container) */}
      <div className="relative z-10 w-full flex-1 min-h-0 overflow-y-auto scrollable-container flex flex-col gap-2 py-2 px-4">
        {/* Top - Bible Widget */}
        <div className="flex-shrink-0 px-2">
          <div className="relative w-full max-w-2xl mx-auto">
            {/* Bible Widget Card */}
            <div className="relative overflow-hidden rounded-2xl shadow-2xl">
              {/* Ambient background effects */}
              <div className="absolute inset-0 bg-gradient-to-br from-[#843c2d]/5 via-transparent to-[#502d26]/5"></div>
              
              {/* Floating particles */}
              <div className="absolute inset-0 overflow-hidden">
                <div className="absolute top-3 right-6 w-1.5 h-1.5 bg-[#ede8df]/30 rounded-full blur-sm liquid-pulse" style={{ animationDelay: '0s', animationDuration: '4s' }}></div>
                <div className="absolute bottom-4 left-8 w-1 h-1 bg-[#b2a491]/25 rounded-full blur-sm liquid-float" style={{ animationDelay: '2s', animationDuration: '6s' }}></div>
              </div>
              
              {/* Widget Content */}
              <div className="relative p-3 sm:p-4">
                {/* Header */}
                <div className="text-center mb-4 sm:mb-5">
                  <h2 className="text-2xl sm:text-3xl md:text-4xl font-bold bg-gradient-to-r from-[#ede8df] to-[#b2a491] bg-clip-text text-transparent mb-1">
                    The Words
                  </h2>
                  <p className="text-xs sm:text-sm text-[#726d6c]/70">
                    {new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}
                  </p>
                </div>
                
                {/* Verse Content */}
                <div className="space-y-2 sm:space-y-3">
                  {verseOfTheDay.loading ? (
                    <div className="space-y-2">
                      <div className="h-3 bg-[#502d26]/20 rounded animate-pulse"></div>
                      <div className="h-3 bg-[#502d26]/20 rounded animate-pulse w-3/4"></div>
                      <div className="h-2.5 bg-[#502d26]/20 rounded animate-pulse w-1/2"></div>
                    </div>
                  ) : (
                    <>
                      <blockquote className="text-xs sm:text-sm text-[#ede8df] leading-relaxed italic">
                        "{verseOfTheDay.text}"
                      </blockquote>
                      
                      {/* Error message if fallback verse */}
                      {verseOfTheDay.error && (
                        <p className="text-xs text-[#843c2d]/80 italic">
                          {verseOfTheDay.error}
                        </p>
                      )}
                    </>
                  )}
                </div>
                
                {/* Action Buttons */}
                <div className="flex items-center justify-center space-x-2 mt-3 pt-3 border-t border-[#502d26]/20">
                  <button 
                    onClick={() => fetchVerse()}
                    disabled={verseOfTheDay.loading}
                    className="px-3 py-1.5 rounded-lg glass-card hover:bg-[#843c2d]/10 transition-all text-xs text-[#b2a491] font-medium disabled:opacity-50"
                  >
                    <svg className="w-3 h-3 inline mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    {verseOfTheDay.loading ? 'Loading...' : 'New Verse'}
                  </button>
                  
                  <button className="px-3 py-1.5 rounded-lg glass-card hover:bg-[#843c2d]/10 transition-all text-xs text-[#b2a491] font-medium">
                    <svg className="w-3 h-3 inline mr-1.5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                    Collect
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        {/* Middle spacer - flexible but minimal */}
        <div className="flex-1 min-h-[0.25rem]"></div>
        
        {/* Middle - Portable Music Player */}
        <div className="flex-shrink-0 flex items-center justify-center px-2">
          <div className="relative w-full max-w-sm">
            {/* Player Card */}
            <div className="relative overflow-hidden rounded-2xl glass-surface shadow-2xl border border-[#502d26]/30">
              {/* Ambient background effects */}
              <div className="absolute inset-0 bg-gradient-to-br from-[#843c2d]/5 via-transparent to-[#502d26]/5"></div>
              
              {/* Now Playing Display */}
              <div className="relative p-2 sm:p-3 text-center">
                {/* Album Art / Play Icon */}
                <div className="w-12 h-12 sm:w-14 sm:h-14 mx-auto mb-1.5 sm:mb-2 rounded-xl glass-card flex items-center justify-center overflow-hidden">
                  {state.currentAlbum?.cover_art_url ? (
                    <Image 
                      src={state.currentAlbum.cover_art_url} 
                      alt={state.currentAlbum.title || 'Album cover'}
                      className="w-full h-full object-cover"
                      width={56}
                      height={56}
                    />
                  ) : state.isPlaying ? (
                    <svg className="w-5 h-5 sm:w-6 sm:h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                    </svg>
                  ) : (
                    <svg className="w-5 h-5 sm:w-6 sm:h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  )}
                </div>
                
                {/* Track Info */}
                <div className="space-y-1 mb-2 sm:mb-3">
                  <h3 className="text-sm sm:text-base font-medium text-[#ede8df] truncate">
                    {state.currentTrack?.title || (albums.length > 0 ? 'Ready to play' : albumError || 'Loading music...')}
                  </h3>
                  <p className="text-xs text-[#b2a491]/80 truncate">
                    {state.currentAlbum?.artist_name || (albums.length > 0 ? `${albums.length} albums available` : 'Fetching albums...')}
                  </p>
                  {albumError && (
                    <p className="text-xs text-[#843c2d]/80 italic">
                      {albumError}
                    </p>
                  )}
                  {state.error && (
                    <p className="text-xs text-red-400 italic bg-red-900/20 rounded px-2 py-1">
                      🚨 {state.error}
                    </p>
                  )}
                </div>
                
                {/* Progress Bar */}
                <div className="mb-3 sm:mb-4">
                  <div className="flex items-center justify-between text-xs text-[#726d6c]/70 mb-1.5">
                    <span>{state.currentTrack ? formatTime(state.currentTime) : '0:00'}</span>
                    <span>{state.currentTrack ? formatTime(state.duration) : '0:00'}</span>
                  </div>
                  <div className="h-1.5 bg-[#502d26]/40 rounded-full overflow-hidden">
                    <div 
                      className="h-full bg-gradient-to-r from-[#843c2d] to-[#b2a491] rounded-full transition-all duration-300" 
                      style={{ 
                        width: state.duration > 0 ? `${(state.currentTime / state.duration) * 100}%` : '0%' 
                      }}
                    ></div>
                  </div>
                </div>
                
                {/* Control Buttons */}
                <div className="flex items-center justify-center space-x-3 sm:space-x-4">
                  {/* Previous */}
                  <button 
                    onClick={previousTrack}
                    disabled={!state.currentTrack}
                    className="p-1.5 sm:p-2 rounded-full glass-card hover:bg-[#843c2d]/10 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    <svg className="w-4 h-4 text-[#b2a491]" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
                    </svg>
                  </button>
                  
                  {/* Play/Pause */}
                  <button 
                    onClick={state.currentTrack ? togglePlayPause : handlePlayRandomAlbum}
                    disabled={loadingAlbums && !state.currentTrack}
                    className="p-2.5 sm:p-3 rounded-full bg-gradient-to-br from-[#843c2d] to-[#502d26] hover:from-[#b2a491] hover:to-[#843c2d] transition-all shadow-lg disabled:opacity-50"
                  >
                    {state.currentTrack ? (
                      state.isPlaying ? (
                        <svg className="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                        </svg>
                      ) : (
                        <svg className="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      )
                    ) : loadingAlbums ? (
                      <svg className="w-5 h-5 text-white animate-spin" fill="none" viewBox="0 0 24 24">
                        <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                        <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                      </svg>
                    ) : (
                      <svg className="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    )}
                  </button>
                  
                  {/* Next */}
                  <button 
                    onClick={nextTrack}
                    disabled={!state.currentTrack}
                    className="p-1.5 sm:p-2 rounded-full glass-card hover:bg-[#843c2d]/10 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    <svg className="w-4 h-4 text-[#b2a491]" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
                    </svg>
                  </button>
                </div>
                
                {/* Action Buttons */}
                <div className="flex items-center justify-center space-x-2 sm:space-x-3 mt-3 sm:mt-4">
                  <button 
                    onClick={handlePlayRandomAlbum}
                    disabled={loadingAlbums || albums.length === 0}
                    className="px-3 py-1.5 rounded-lg glass-card hover:bg-[#843c2d]/10 transition-all text-xs text-[#b2a491] font-medium disabled:opacity-50"
                  >
                    <svg className="w-3 h-3 inline mr-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                    </svg>
                    {loadingAlbums ? 'Loading...' : albums.length > 0 ? 'Play Album' : 'No Albums'}
                  </button>
                  <button 
                    onClick={loadAvailableAlbums}
                    disabled={loadingAlbums}
                    className="px-3 py-1.5 rounded-lg glass-card hover:bg-[#843c2d]/10 transition-all text-xs text-[#b2a491] font-medium disabled:opacity-50"
                  >
                    <svg className="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Refresh
                  </button>
                  <button 
                    onClick={handleBrowseMusic}
                    className="px-3 py-1.5 rounded-lg glass-card hover:bg-[#843c2d]/10 transition-all text-xs text-[#b2a491] font-medium"
                  >
                    <svg className="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                    </svg>
                    Browse
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        {/* Middle spacer - flexible but minimal */}
        <div className="flex-1 min-h-[0.25rem]"></div>
        
        {/* Bottom - Game Window (Compact) */}
        <div className="flex-shrink-0 h-16 sm:h-20 md:h-24 px-2">
          <div className="relative h-full w-full overflow-hidden rounded-2xl glass-surface shadow-2xl border border-[#502d26]/30">
            {/* Ambient background effects */}
            <div className="absolute inset-0 bg-gradient-to-br from-[#843c2d]/5 via-transparent to-[#502d26]/5"></div>
            
            {/* Floating glass particles in window */}
            <div className="absolute inset-0 overflow-hidden">
              <div className="absolute top-1 left-2 w-1 h-1 bg-[#ede8df]/20 rounded-full blur-sm liquid-pulse" style={{ animationDelay: '0s', animationDuration: '4s' }}></div>
              <div className="absolute bottom-2 right-3 w-1.5 h-1.5 bg-[#b2a491]/15 rounded-full blur-md liquid-float" style={{ animationDelay: '2s', animationDuration: '6s' }}></div>
            </div>
            
            {/* Window header */}
            <div className="relative flex items-center justify-between px-2 sm:px-3 py-1 sm:py-1.5 border-b border-[#502d26]/30 backdrop-blur-sm">
              <div className="flex items-center space-x-1 sm:space-x-2">
                <div className="flex space-x-1">
                  <div className="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-[#843c2d]/60"></div>
                  <div className="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-[#b2a491]/60"></div>
                  <div className="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-[#ede8df]/60"></div>
                </div>
                <h2 className="text-xs font-medium bg-gradient-to-r from-[#ede8df] to-[#b2a491] bg-clip-text text-transparent">
                  Game Portal
                </h2>
              </div>
              <div className="text-xs text-[#726d6c]/70">
                Coming Soon
              </div>
            </div>
            
            {/* Game content area */}
            <div className="relative h-[calc(100%-24px)] sm:h-[calc(100%-28px)] flex items-center justify-center">
              {/* Placeholder content */}
              <div className="text-center space-y-1">
                <div className="relative inline-block">
                  <div className="absolute inset-0 bg-[#843c2d]/20 rounded-full blur-md"></div>
                  <div className="relative w-5 h-5 sm:w-6 sm:h-6 mx-auto glass-card rounded-lg flex items-center justify-center">
                    <svg className="w-2.5 h-2.5 sm:w-3 sm:h-3 text-[#b2a491]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.5a4.5 4.5 0 014.5 4.5v0a4.5 4.5 0 01-4.5 4.5H9m0-9H7.5a4.5 4.5 0 00-4.5 4.5v0a4.5 4.5 0 004.5 4.5H9m-3-7h6" />
                    </svg>
                  </div>
                </div>
                <div className="space-y-0.5">
                  <h3 className="text-xs font-medium bg-gradient-to-r from-[#ede8df] to-[#b2a491] bg-clip-text text-transparent">
                    Games Coming Soon
                  </h3>
                  <p className="text-xs text-[#726d6c]/80 max-w-xs">
                    Interactive experiences
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        {/* Bottom spacer - minimal */}
        <div className="flex-shrink-0 h-2"></div>
      </div>
    </div>
  );
}
