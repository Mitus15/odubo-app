{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs_18", "ffmpeg"]
        },
        "install": {
          "cmds": ["cd worker && npm ci"]
        },
        "build": {
          "cmds": []
        }
      },
      "start": {
        "cmd": "cd worker && npm start"
      }
    }
  }
}
