-- Migration: Add user likes/favorites system
-- This creates the foundation for user playlists and recommendations

-- User likes for tracks (foundation for playlists)
CREATE TABLE IF NOT EXISTS user_track_likes (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id TEXT NOT NULL,
  track_id TEXT NOT NULL,
  liked_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE,
  FOREIGN KEY (track_id) REFERENCES tracks (id) ON DELETE CASCADE,
  UNIQUE(user_id, track_id) -- Prevent duplicate likes
);

-- User likes for videos/films (foundation for video playlists)
CREATE TABLE IF NOT EXISTS user_video_likes (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id TEXT NOT NULL,
  video_id TEXT NOT NULL,
  liked_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE,
  FOREIGN KEY (video_id) REFERENCES films (id) ON DELETE CASCADE,
  UNIQUE(user_id, video_id) -- Prevent duplicate likes
);

-- User likes for albums (collection likes)
CREATE TABLE IF NOT EXISTS user_album_likes (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id TEXT NOT NULL,
  album_id TEXT NOT NULL,
  liked_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE,
  FOREIGN KEY (album_id) REFERENCES albums (id) ON DELETE CASCADE,
  UNIQUE(user_id, album_id) -- Prevent duplicate likes
);

-- User playlists (extends existing playlist system with user ownership)
ALTER TABLE playlists ADD COLUMN user_id TEXT REFERENCES users(id) ON DELETE CASCADE;

-- User listening/viewing history (for recommendations)
CREATE TABLE IF NOT EXISTS user_listening_history (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id TEXT NOT NULL,
  track_id TEXT NOT NULL,
  played_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  play_duration INTEGER, -- How long they listened in seconds
  completed BOOLEAN DEFAULT FALSE, -- Did they listen to the full track
  FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE,
  FOREIGN KEY (track_id) REFERENCES tracks (id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS user_viewing_history (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id TEXT NOT NULL,
  video_id TEXT NOT NULL,
  viewed_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  view_duration INTEGER, -- How long they watched in seconds
  completed BOOLEAN DEFAULT FALSE, -- Did they watch the full video
  FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE,
  FOREIGN KEY (video_id) REFERENCES films (id) ON DELETE CASCADE
);

-- Indexes for performance
CREATE INDEX IF NOT EXISTS idx_user_track_likes_user_id ON user_track_likes(user_id);
CREATE INDEX IF NOT EXISTS idx_user_track_likes_track_id ON user_track_likes(track_id);
CREATE INDEX IF NOT EXISTS idx_user_video_likes_user_id ON user_video_likes(user_id);
CREATE INDEX IF NOT EXISTS idx_user_video_likes_video_id ON user_video_likes(video_id);
CREATE INDEX IF NOT EXISTS idx_user_album_likes_user_id ON user_album_likes(user_id);
CREATE INDEX IF NOT EXISTS idx_user_album_likes_album_id ON user_album_likes(album_id);
CREATE INDEX IF NOT EXISTS idx_user_listening_history_user_id ON user_listening_history(user_id);
CREATE INDEX IF NOT EXISTS idx_user_viewing_history_user_id ON user_viewing_history(user_id);
CREATE INDEX IF NOT EXISTS idx_playlists_user_id ON playlists(user_id);
